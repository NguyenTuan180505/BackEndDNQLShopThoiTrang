  "components": {
    "schemas": {
      "AddCartRequest": {
        "type": "object",
        "properties": {
          "productID": {
            "type": "integer",
            "format": "int32"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "CategoryCreateDto": {
        "type": "object",
        "properties": {
          "categoryName": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CategoryUpdateDto": {
        "type": "object",
        "properties": {
          "categoryName": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateOrderDirectDto": {
        "required": [
          "paymentMethod",
          "shippingAddress"
        ],
        "type": "object",
        "properties": {
          "shippingAddress": {
            "minLength": 1,
            "type": "string"
          },
          "paymentMethod": {
            "minLength": 1,
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItemInputDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateOrderFromCartDto": {
        "required": [
          "paymentMethod",
          "shippingAddress"
        ],
        "type": "object",
        "properties": {
          "shippingAddress": {
            "minLength": 1,
            "type": "string"
          },
          "paymentMethod": {
            "minLength": 1,
            "type": "string"
          },
          "note": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateOrderFromSelectedCartDto": {
        "type": "object",
        "properties": {
          "cartItemIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            },
            "nullable": true
          },
          "shippingAddress": {
            "type": "string",
            "nullable": true
          },
          "paymentMethod": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreatePaymentDto": {
        "required": [
          "orderID",
          "paymentMethod"
        ],
        "type": "object",
        "properties": {
          "orderID": {
            "type": "integer",
            "format": "int32"
          },
          "paymentMethod": {
            "minLength": 1,
            "type": "string"
          },
          "transactionID": {
            "type": "string",
            "nullable": true
          },
          "amount": {
            "minimum": 0,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "CreateReviewDto": {
        "required": [
          "productID"
        ],
        "type": "object",
        "properties": {
          "productID": {
            "type": "integer",
            "format": "int32"
          },
          "rating": {
            "maximum": 5,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "comment": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "imageUrls": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "videoUrls": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginDto": {
        "type": "object",
        "properties": {
